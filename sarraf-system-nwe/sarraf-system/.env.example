# Public Supabase configuration
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Server-only Supabase secret used by protected API routes. Never prefix with VITE_.
SUPABASE_SERVICE_ROLE_KEY=

# Server-only receipt OCR providers (never prefix these with VITE_)
GROQ_API_KEY=
GEMINI_API_KEY=
GOOGLE_CLOUD_VISION_API_KEY=
ANTHROPIC_API_KEY=

# Optional: google-vision, gemini, groq, or claude. Fallbacks remain enabled.
OCR_PROVIDER=
